+  let waitError = '';
+  const waitMs = WAIT_MS;
+  say(`     · 点「确认」的返回：${JSON.stringify(actionResult)}${actionError ? ` / 抛错：${actionError}` : ''}`);
+  try {
+    task = await waitTask(h, taskId,
+      (row) => ['posted', 'posted_delivery_pending'].includes(row.status) || Boolean(row.posting_error),
+      `入账 ${taskId}`, waitMs);
