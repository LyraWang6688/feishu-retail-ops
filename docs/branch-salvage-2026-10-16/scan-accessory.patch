-  assert.notEqual(sha256Of(Buffer.concat([raw, Buffer.from(' ')])), FROZEN_SHA256,
-    '多一个空格 ⇒ **必须**报红 ✓');
-  // ② 中间**换一个字符** ⇒ 指纹必须变
-  const text = raw.toString('utf8');
