-      for (const entry of item.entries) {
-        const quantity = positiveInteger(entry.quantity);
-        if (quantity === null) {
-          skipped.push({ size: String(entry.size ?? ''), reason: 'quantity_not_positive_integer' });
-          continue;
-        }
