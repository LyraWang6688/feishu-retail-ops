+  [KEYS.itemAmount]: DEFAULTS.itemAmount,
+  [KEYS.itemAmountGeneric]: DEFAULTS.itemAmountGeneric,
+  [KEYS.itemAmountUnknownTotal]: DEFAULTS.itemAmountUnknownTotal,
+  [KEYS.unknownTotal]: DEFAULTS.unknownTotal,
