+const alternation = (words) => [...words].sort((left, right) => right.length - left.length)
+  .map((word) => word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
+
+/** 金额：`120` / `120 元` / `¥120`（尾款允许不带单位，她说「下次收120」时就是这样）。 */
+const AMOUNT = '[¥￥]?\\s*(\\d+(?:\\.\\d{1,2})?)\\s*(?:元|块)?';
