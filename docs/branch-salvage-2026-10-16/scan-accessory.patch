+  let seq = 0;
+  const nextId = (prefix) => `${prefix}_${++seq}`;
+  const reply = async ({ path: p, data } = {}) => {
+    const parent = String(p?.message_id || '');
+    let threadId = '';
+    if (data?.reply_in_thread === true) {
