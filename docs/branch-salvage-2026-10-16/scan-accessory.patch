+  GENERIC_SUPERSEDED_BY,
+  TEXT_TOPIC_PATTERNS,
+  ITEM_QUANTITY_PATTERN,
+  ITEM_FIELD_PATTERN,
+  PAYMENT_FIELD_PATTERN,
