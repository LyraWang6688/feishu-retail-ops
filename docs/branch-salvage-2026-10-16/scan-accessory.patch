-        } catch (error) {
-          failed += 1;
-          error_(events.detailWriteFailed, {
-            session_id: sessionId, batch_no: batchNo, idempotency_key: keyValue,
-            error: String(error?.message || error), request_id: correlation.request_id || undefined,
-          });
-        }
