-});
-
-test('AC-FRZ2 ⭐ 探针：指纹**真能认出**改动（证明 AC-FRZ1 不是空跑 ✓）', () => {
-  const raw = fs.readFileSync(TARGET);
-  assert.equal(sha256Of(raw), FROZEN_SHA256, '原样 ⇒ 指纹一致 ✓');
