+    async resolveProduct({ itemNo }) { return { recordId: `${this.marker}:${itemNo}` }; }
+  }
+  const service = new LarkMvpService({ client: {}, gateway: {}, store: makeStore(), recognizer: {},
+    references: new ResolverUsingThis('own-this') });
