+const waitFor = async (label, predicate, timeoutMs = 240_000) => {
+  const started = Date.now();
+  for (;;) {
+    const value = await predicate();
+    if (value) return value;
+    if (Date.now() - started > timeoutMs) throw new Error(`${label} 超时（${timeoutMs}ms）`);
+    await sleep(500);
+  }
+};
