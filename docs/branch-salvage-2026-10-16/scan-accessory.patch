+  TIME_WORDS,
+  AUX_WORDS,
+  VERB_WORDS,
+  TAIL_NOUN_WORDS,
+  OWED_HEAD_WORDS,
+  FUTURE_MARKERS,
+  CLAUSE_BOUNDARY_WORDS,
+  MONEY_NOT_SETTLED_WORDS,
+  SALES_DEPOSIT_TOTAL_UNKNOWN,
+  TAIL_PATTERNS,
+  FUTURE_MARKER_PATTERN,
+  CLAUSE_BOUNDARY_PATTERN,
+  MONEY_NOT_SETTLED_PATTERN,
+};
