+  let seq = 0;
+  const gateway = {
+    reads,
+    records,
+    table: (key) => V1_BITABLE_SCHEMA.tables[key],
+    validateTables: async () => [],
+    listAll: async (key) => {
+      reads.total += 1;
+      if (key in reads) reads[key] += 1;
+      return records.get(key) || [];
+    },
+    get: async (key, id) => (records.get(key) || []).find((row) => row.record_id === id),
