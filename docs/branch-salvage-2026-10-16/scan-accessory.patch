-  assert.equal(tapEventName(0), UI_TAP.events.repeated, '同一毫秒内又点了一次 ⇒ 重复 ✓');
-  assert.equal(tapEventName(windowMs), UI_TAP.events.repeated, '正好在窗口边上 ⇒ 算重复 ✓');
