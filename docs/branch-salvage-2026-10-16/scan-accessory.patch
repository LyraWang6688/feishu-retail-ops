-  assert.deepEqual(exempt.sort(), ['larkHeartbeatEmptyBodyRepro.cjs', 'listenLoopbackSentinel.test.js'],
-    '豁免要逐个写明理由（文件里要有 `// keep-alive-exempt: <理由>`）并把这里一起更新');
