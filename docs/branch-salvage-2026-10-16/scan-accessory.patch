+  new RegExp(`(?:${alternation(TIME_WORDS)})\\s*(?:${alternation(AUX_WORDS)})?`
+    + `\\s*(?:${alternation(VERB_WORDS)})?\\s*${AMOUNT}`),
+  // ③ 没有时间词：还欠 / 还差 / 还要收 / 再付 / 补收 …
+  new RegExp(`(?:${alternation(OWED_HEAD_WORDS)})\\s*(?:${alternation(VERB_WORDS)})?\\s*${AMOUNT}`),
+]);
