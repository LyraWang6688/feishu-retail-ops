+ *   保留下来的结构化验收是「实际数量」「实际金额」（＋本来就在的「到货状态」）。
+ */
+const arrivalColumns = (records) => {
+  const fields = batchFields(records);
+  return {
+    实际数量: fields['实际数量'], 实际金额: fields['实际金额'],
+  };
+};
