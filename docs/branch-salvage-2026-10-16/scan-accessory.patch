+// 按 record_id 直接读「库存流水」（售后这次**真正写的那几条**）：
+// 只按来源明细筛选会把首次销售那条「销售减少」也捞进来（换货的原行同时挂着两条）。
+const readLedgerByIds = async (h, recordIds = []) => {
