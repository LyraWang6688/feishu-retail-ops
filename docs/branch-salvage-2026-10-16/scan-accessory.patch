-  try {
-    const res = await fetch(`${BASE}${path}`, { redirect: 'manual', signal: controller.signal });
-    const text = await res.text().catch(() => '');
-    return { status: res.status, location: res.headers.get('location') || '', text };
-  } finally {
-    clearTimeout(timer);
-  }
