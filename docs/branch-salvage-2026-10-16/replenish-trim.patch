-const F = (table, key) => V1_BITABLE_SCHEMA.tables[table].fields[key];
-const TOTAL = F('salesEntry', 'totalAmount');
-const GIFT = F('salesEntry', 'gift');
-const ORDER_NO = F('salesEntry', 'orderNo');
