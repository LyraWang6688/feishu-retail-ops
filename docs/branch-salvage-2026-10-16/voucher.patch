-  };
-  const batchA = 'CGD-AA-0001';
-  const batchB = 'CGD-AA-0002';
-  batchOf(batchA);
-  batchOf(batchB);
-  data.product.push({
-    record_id: PRODUCT,
-    fields: { [F('product').itemNo]: 'YD6693-2', [F('product').color]: '黑色' },
-  });
-  SIZES.forEach((size) => {
-    data.sizeManagement.push({
-      record_id: `size_${size}`, fields: { [F('sizeManagement').size]: size },
-    });
-  });
-  data.behavior.push({
-    record_id: 'beh_in',
-    fields: {
