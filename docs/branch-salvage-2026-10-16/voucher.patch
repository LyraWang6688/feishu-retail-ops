+    assert.match(prompt, /同时/);
+    assert.match(prompt, /各分项之和|各件金额之和|逐件金额之和/);
+    // ② 与规则 6 自洽：只给整单金额仍然留空、要求补充（这条不许被改掉）。
+    assert.match(prompt, /只给整单金额/);
+    // ③ 与规则 9 自洽：多件时整单实收不再覆盖单件金额。
+    assert.match(prompt, /多件/);
