+};
+
+const jsonLogs = (logs) => logs
+  .map((line) => { try { return JSON.parse(line); } catch { return null; } })
+  .filter(Boolean);
+
+const CASH = (itemNo = 'B26002-52') => itemLine(itemNo, '现货', { payments: [{ amount: 228, method: '微信' }] });
+
