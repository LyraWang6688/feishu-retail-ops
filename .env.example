# Server Config
# 服务监听地址：默认 127.0.0.1（只回环，公网走 Nginx）。
# 不要改成 0.0.0.0——那会把 Express 直接暴露在公网，绕过 Nginx 的 TLS 与过滤。
HOST=127.0.0.1
PORT=3000
# 飞书租户域名：用来拼"打开这条记录"的链接（销售卡片上提示补货品资料用）
# 形如 https://<你的租户>.feishu.cn
FEISHU_TENANT_DOMAIN=https://scnzoiwpgxik.feishu.cn

API_KEY=your_api_key
# Read-only browser token for /workbench. Keep separate from API_KEY.
ENABLE_CORS=false
UPLOAD_TTL_MS=86400000
UPLOAD_CLEAN_INTERVAL_MS=3600000

# 退换货第一期「查销售记录」：只读查询窗口与候选上下文有效期。
# 两个都有默认值（5 天 / 600000 毫秒 = 10 分钟），不配也能跑；
# 写坏（0、负数、非数字）会回落到默认值，不会把窗口变成 0 天。
# SALE_LOOKUP_DAYS=5
# SALE_LOOKUP_TTL_MS=600000

FEISHU_SYNC_CONCURRENCY=4
FEISHU_RETRY_MAX=3
FEISHU_RETRY_BASE_MS=300
FEISHU_RETRY_MAX_DELAY_MS=4000

# Doubao (Volcengine) Config
# ── 模型现在只有一组：文字解析（没有默认值、不跨供应商兜底）──────────────────
# 2026-10-05：原先的图片识别那一组（VISION_LLM_*，鞋盒 / 供应商到货单照片）
# 已随「采购到货 → 拍照识别」链路整体退场删除。那组配置、识别提示词、
# 视觉客户端的硬超时都没有读取点了，留着会让人以为系统还在读图片。
#
# 例：走 DeepSeek
TEXT_LLM_API_KEY=your_deepseek_api_key
TEXT_LLM_BASE_URL=https://api.deepseek.com
TEXT_LLM_MODEL=deepseek-chat
#
# 想换回火山方舟 / 豆包时，把三个值换成：
#   BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   MODEL=<你的推理接入点 ID>
#
# 缺 TEXT_LLM_* 就在调用时报错——不会静默改用别家（否则"以为在用 A、实际在用 B"）。

# ── 到货「等待与提示」的四个阈值（ARRIVAL_*）已删除 ──────────────────────────
# 它们只服务拍照识别的「识别中」中间态（每 N 毫秒补一条提示 / 放弃等待 / 判失败 /
# 补发次数上限），随识别链路一起退场。识别状态与识别失败原因两个字段也已从生产表删除。

# ── 「到齐就发」/ 归批窗口 / 读记录重试（**2026-10-09 全部删除**）─────────────
# 这四组变量（REPORT_READ_MAX_RETRIES · REPORT_READ_RETRY_DELAY_MS ·
# REPORT_BATCH_WINDOW_MS · PURCHASE_RETURN_BATCH_WINDOW_MS）只服务
# **「信息填写」表变更 → 文字报单 → 归批出图**那条入口；那张表已从 Base 删除、
# 入口退场 ⇒ 变量与它们背后的 config 模块（reportReadRetry / reportBatchWindow /
# purchaseReturnBatchWindow）**一并删除**，没有任何读取点。
# 采购申请现在由**扫码补货报单 / 工作台**直接调 `publishPurchaseRequest`（免确认）。

# Feishu robot/web app used by the V1 private-chat workflow. The application
# must have access to the V1 Base and subscribe to im.message.receive_v1 plus
# card.action.trigger.
LARK_AGENT_APP_ID=your_lark_agent_app_id
LARK_AGENT_APP_SECRET=your_lark_agent_app_secret
LARK_AGENT_VERIFICATION_TOKEN=your_lark_verification_token
LARK_AGENT_ENCRYPT_KEY=your_lark_encrypt_key

# Feishu web-app login for the workbench. Keep disabled until the exact
# callback URL is registered in the Feishu developer console.
LARK_WEB_AUTH_ENABLED=false
LARK_WEB_REDIRECT_URI=https://workbench.bamamei.online/api/auth/feishu/callback
LARK_WEB_SESSION_SECRET=replace_with_openssl_rand_hex_32
# Optional comma-separated open_id allowlist. Empty means all visible app users.
WORKBENCH_ALLOWED_OPEN_IDS=

# Current V1 data foundation. Table IDs below still default to the checked-in
# V1 schema, but the target Base must always be configured explicitly:
# there is no fallback, so a missing value fails loudly instead of silently
# pointing at a production Base.
FEISHU_V1_BITABLE_APP_TOKEN=

# 目标环境声明。会写多维表格的脚本只在 FEISHU_TARGET_ENV=test 时运行；
# 生产环境不要设置该变量，脚本写入生产必须显式设置
# FEISHU_ALLOW_PRODUCTION_WRITE=true。
FEISHU_TARGET_ENV=

FEISHU_V1_PRODUCT_TABLE_ID=tbl9z4Oi8Vc57Kin
# 其他配品（腰带、鞋油、袜子、包等）。没有默认值：不同租户这张表不同，留空时销售只支持鞋。
FEISHU_V1_ACCESSORY_TABLE_ID=
FEISHU_V1_BEHAVIOR_TABLE_ID=tblbTvUT4AFsCK4K
FEISHU_V1_SIZE_TABLE_ID=
FEISHU_V1_PAYMENT_METHOD_TABLE_ID=tblH7YzA1v5vJzEi
FEISHU_V1_PAYMENT_RECORD_TABLE_ID=tblTpLOtTLhWxXvm
FEISHU_V1_SUPPLIER_TABLE_ID=tblFfXkLct2ZIGGq
FEISHU_V1_SALES_ENTRY_TABLE_ID=tblLjFe3NjU61xKB
FEISHU_V1_SALES_DETAIL_TABLE_ID=tblxW5WMKDULyolA
FEISHU_V1_PURCHASE_BATCH_TABLE_ID=tblvLOXKESNTbZ7v
# ⚠️ 2026-10-09：`FEISHU_V1_PURCHASE_REPORT_TABLE_ID`（「信息填写」表）**已删除** ——
#    业务负责人把那张表**整个从 Base 删掉了**（`TableIdNotFound` 1254041），
#    口径是「自然语言 ＋ AI 录入」整套退场。这个变量已**没有任何读取点**，
#    再加回来只会指向一张不存在的表（部署闸门 `v1:schema-check:all` 会当场判红）。
FEISHU_V1_PURCHASE_REQUEST_TABLE_ID=tbli1ygPtss5CWCH
# ⚠️ 2026-10-07 晚：`FEISHU_V1_PURCHASE_ARRIVAL_TABLE_ID` **已删除** ——
#    业务负责人把「到货验收」表**整个删掉了**（到货信息的落点搬到「报货批次」那一行，
#    见 schema 的 `purchaseOrderBatch.acceptanceText / confirmStatus`）。
#    这个变量已经**没有任何读取点**，再加回来只会指向一张不存在的表。
# ── 「采购到货 → 拍照识别 → 入库」链路开关（已退场，开关**刻意保留**）──
# ⚠️ 2026-10-05：这条链路已经整体退场（业务负责人删了「类型」「识别状态」
# 「识别失败原因」三个字段，改成纯对话驱动），入口分派也从 routes/larkEvents.js 摘掉了。
# 所以这个变量**现在没有任何读取点**——留着是为了将来恢复「对话到货」时有现成的、
# 语义明确的开关可用（它已经钉住了"空字符串不等于关闭"那个坑，见
# src/config/purchaseArrivalIntake.js 的文件头）。
#   · 判定规则（将来接线时依旧）：只有**显式**填 false 才关闭（忽略大小写与首尾空格）；
#     留空、true、1 或写错的值都=开启。不能用 `||` 兜底，否则清空环境变量根本关不掉。
#   · 现状（2026-10-07 晚更新）：那张「到货验收」表**也已经被删掉了** ⇒ 连"往它新增记录"
#     这件事都不存在了，原来那条 `lark.intake.arrival_retired` 排查日志一并删除。
#     这个开关仍然**刻意保留**（将来恢复「对话到货」时的现成旋钮），但同样没有任何读取点。
#   · 采购申请（扫码补货 → 采购申请 PNG）**不受这个开关影响**，照常运行
#     （那条由「信息填写」表变更触发的报单入口已于 2026-10-09 退场）。
PURCHASE_ARRIVAL_INTAKE_ENABLED=true
# ── 「采购到货：群话题对话式核对」的入口开关（2026-10-06 上线）──
# 这条链路**不是**上面那条拍照识别链路的复活：它是纯对话驱动 —— 人在采购群里那个话题里
# 用自然语言说这次实际到货和采购申请的差异（完全一样 / 比申请多 / 比申请少），
# 说「完毕」之后机器人发一张带「是」「否」的卡片，**点「是」才入库**。
#   · 只认**显式布尔**：false / 0 / no / off（忽略大小写与首尾空格）= 关闭；
#     true / 1 / yes / on = 开启；**留空 = 用默认值（开启）**。
#     ⚠️ 刻意不用 `process.env.X || 默认值` 那种写法：空串会被当成"没配"而回落到默认值，
#     于是这个开关**关不掉**（AGENTS.md 专门点了这个坑）。
#   · 关掉之后：话题里的消息**一个字都不处理**（不记会话、不调模型、不发卡片、不写表），
#     只留一条 purchase.arrival.reconcile.disabled 日志。
#   · 扫码补货报单 / 销售链路**都不受这个开关影响**（文字报单与采购退货入口
#     已于 2026-10-09 随「信息填写」整表删除一起退场）。
#   · 实现与验收标准见 docs/arrival-conversation-reconcile-2026-10-06.md。
#   ⭐ 2026-10-07 深夜她的口径（逐字）：「等到货之后，**请在卡片里填写实际到货情况**……
#     **用户填写内容之后，再点击提交**。以这个来作为**触发后续的到货验收**」
#     ⇒ 核对卡片上多了一块**表单**（多行文本输入框 ＋ 「提交」按钮，同一个表单容器里）。
#     **提交走的就是上面那条解析**（把 form_value 的文字当成"她在话题里说的那句话"），
#     **没有第二套解析、也没有第二个开关** —— 它跟这个话题入口**共用这一个开关**。
#     ⚠️ 表单的 name / label / placeholder / 提交按钮文案 / 已提交文案 / 老客户端降级文案
#        **全部是代码级配置**（`server/src/config/arrivalConversation.js` 的
#        `ARRIVAL_FORM_DEFAULTS` ＋ `card.submitted*` ＋ `replies.submit*`），**刻意没有环境变量**。
#     ⚠️ 输入框需飞书 V6.8+（表单容器 V6.6+）⇒ 低版本走降级文案，
#        **「在话题里说话」那条入口一直留着**。
#     验收标准与逐条对照见 docs/arrival-card-form-input-2026-10-08.md。
PURCHASE_ARRIVAL_CONVERSATION_ENABLED=true
# ── 「话题里的二次处理识别」（预定 / 现货待收的进展同步，2026-10-06 上线）──
# 她在**销售话题**里说「收到微信 500」这类话时，判断它是【那笔的进展同步】还是
# 【新的销售原话】：进展 → 记到那笔上（收款 / 交付），**不新建销售记录**；
# 判不清 → 回一句问她，**绝不猜**。判据（词表 / 正则 / 文案）在 config/salesProgressIntake。
#   · 只认**显式布尔**：false / 0 / no / off = 关闭；true / 1 / yes / on = 开启；
#     **留空 = 用默认值（开启）**（同样刻意不用 `||` 兜底，见 AGENTS.md 那个坑）。
#   · 只影响「群 + 话题 + 已定位到某笔销售」这一种消息；**私聊行为一个字不变**。
SALES_PROGRESS_INTAKE_ENABLED=true
# ⭐⭐ 上面那个是**整条二次处理**的开关；下面这三个是**"说话还触不触发写库"**的旋钮
#   （业务负责人 2026-10-08 拍板的**乙**：「只留按钮：说话不再触发了」）。
#   · `false`（**默认**）= 她在话题里说进展词（收到钱 / 拿走了 / 成交）→ **零写库**
#     （不交付、不扣库存、不记收款、不改状态），只回下面那句提示；
#     触发链路的入口只剩**那张卡上的【确认成交】**（点它照常钱货一起处理）。
#   · `true` = **旧行为逐字恢复**（说话照样写库）—— 将来要恢复就只翻这一个开关。
#   ⚠️ 词表与判据代码**刻意保留**（`config/salesProgressIntake`）。
#   ⚠️ 与 `SALES_PROGRESS_INTAKE_ENABLED` 的分工：那个关掉 = 这句话**不归二次处理**
#     （会被当成新销售原话送进 AI）；这个关掉 = 判据照跑、只是**不写库**、改回提示。
SALES_PROGRESS_TEXT_TRIGGER_ENABLED=false
# 说话不再触发时回的那**一句**提示（配置先行；**留空 = 回退默认**，不许把提示配没了 = 静默）。
SALES_PROGRESS_TEXT_NOTICE=这单请在卡片上的【确认成交】点一下～
# 提示的去重窗口（毫秒，默认 5 分钟）：她是语音输入，可能重复说同一句 ⇒
# **同一话题**在这个窗口内只提示一次（不刷屏）。0 = 不去重（每句都回）。
SALES_PROGRESS_TEXT_NOTICE_WINDOW_MS=300000
# ── 售后的钱与"原单动不动"（业务负责人 2026-10-08 逐字口径）──
# 退货收款 = **改状态**：找到原销售单，把那双鞋的「履约状态」改成「已退货」，
#   再把**原收款记录**的「收款状态」改成 **已退款**（用户要资金）/ **已留存**（用户留存）
#   —— **不新建**收款记录；金额没变就一笔都不动。旧行为（新建一条「交易方向=退回」的
#   收款行）整体保留在下面这个开关里，**留空 = 默认走她的口径**：
#     AFTER_SALES_RETURN_FUNDS_MODE=updateStatus   # 默认；改原收款行的状态
#     AFTER_SALES_RETURN_FUNDS_MODE=newReturnRow   # 回退到改动前的旧行为
#   ⚠️ 只认这两个取值，写别的**当场报错**（不静默取默认）。
#   ⚠️ 只有**退货**走这条腿；换货/赔货的差价照旧新建「收款明细」（驳回的差价状态=已退款）。
# 「售后次数」：每做成一笔售后（退/换/赔各一次）**原销售主表的「售后次数」+1**，
#   同一次售后重放/重试只 +1 —— 这是「原主表一字不动」的**唯一例外**（她 2026-10-08 要的）。
# 除「售后次数」外，售后**不改原销售主表的任何字段**，「退过没退过」记在原「销售明细」的
# 「履约状态 = 已退货」＋ 新建的那条退货单（交易类型 = 销售退货）上。
# ⚠️ 原单「销售状态」那一列的语义是"明细写进去了没有"（未写入/部分写入/已写入/写入失败），
#    **没有「已退货」这个选项** —— 真写下去飞书会自动新建选项，把那一列搞乱。
# ⚠️ 曾经有一个"售后回写原单销售状态"的开关控制这件事，已于 2026-10-06 整体删除
#    （它默认就是关的，删掉是行为零变化）；不要再加回来。
# ⚠️ 「钱先存着 / 用户留存」的落点**不再是**「客户往来货款」那张表（她 2026-10-08 整表删除）
#    —— 退货的留存改走**原收款记录的「收款状态」= 已留存**；换货/赔货的 prepaid 仍**大声失败**
#    （不静默改成写「收款明细」，那是记错账）。
AFTER_SALES_RETURN_FUNDS_MODE=
# ── 🔴 私聊链路已移除（业务负责人 2026-10-07：「以后私聊这条链路我们就没有了」）──
# 入口统一到【群聊 + 话题】：私聊消息**只记一条 lark.private_chat.disabled 日志**，
# 不建任务、不进 AI、不读表、不写表、**也不回消息**。
# ⚠️ **没有开关** —— 她拍板的是「代码里一行私聊都不留」（ⓐ，见
# docs/private-chat-removal-decision-2026-10-07.md）。**不要**加
# `PRIVATE_CHAT_INTAKE_ENABLED` 之类的变量：要恢复私聊是**重新实现**那条链路，
# 不是翻一个开关（那正是被否掉的 ⓑ）。
# ⚠️ 顺带：没有群上下文的任务**没有去处**（私聊没了），只记一条
# `lark.private_chat.send_skipped`；其中「工作台触发的补样品提醒」不再发任何消息
# —— 这是**有意的行为变化**（旧行为是静默发私聊）。
# ── 群聊采购链路（采购单发到群 + 群里 @ 机器人）──
# 采购单发到哪个群（chat_id，形如 oc_xxx）。**没有默认值**：
#   · 留空 = 采购申请照常写成，但图与说明**不发**，并打一条
#     purchase.request.image.skipped 警告（reason=purchase_chat_id_unconfigured）便于排查；
#   · 刻意**不回落**到经办人私聊——业务负责人明确说采购单不再看经办人，
#     悄悄发私聊会让人误以为已经升级到群了。
PURCHASE_CHAT_ID=
# 机器人自己的 open_id（形如 ou_xxx），判「群聊里有没有 @ 机器人」的唯一依据。
# **没有默认值**：留空时群聊消息一律不处理（私聊不受影响），并打一条
# lark.group.bot_open_id_missing 警告。留空不会"猜可能是 @ 我"——群里日常聊天
# 被误触发、或她的指令被静默丢掉，两种后果都不接受。
LARK_BOT_OPEN_ID=
# 「这条消息我没认出来是哪一批 / 我分不清是哪一批」的两句回复文案（2026-10-07 搬进配置）。
# 里面的 `{prefixes}` 会自动填成**识别批次号的前缀**（默认 `CGD / BH`）—— 报货批次号从
# `BH-…`（手填）改成 `CGD-…`（代码生成）之后，那句话不能再写死「BH-开头的那个」，
# 否则她会照着去说一个我们已经不生成的前缀、永远"认不出"（而且只回一句问清楚，静默）。
# ⚠️ 留空 = 回落默认（这是她在群里唯一能看到的那句话，留空等于把"该怎么办"弄丢）。
# PURCHASE_GROUP_NO_BATCH_REPLY=这条消息我没认出来是哪一批采购单～你引用一下我发的采购单，或者把批次号（{prefixes} 开头的那个）说给我。
# PURCHASE_GROUP_AMBIGUOUS_BATCH_REPLY=我分不清你说的是哪一批～引用一下我发的采购单，或者把批次号（{prefixes} 开头的那个）说给我。
# 「收到」表情的 emoji_type，默认 OneSecond（真机验证有效）。表情只是"收到了"的信号，
# 配错不影响任何业务事实；加不上只记 lark.sales.acknowledgement.failed 警告。
LARK_ACK_REACTION=OneSecond
# ── 采购群那条话术（@经办人 + 供应商 + 这批 N 双）──
# 业务负责人 2026-10-07 逐字：「不用说几条，只给出多少双就可以了」
#   ⇒ 模板里**没有「N 条」、也没有「共」**，只有**双数**（`{pairs}`）。
# 她看到的（逐字）：`@王颖 三星 这批 13 双，图可以直接转给供应商。`
# 取值规则：**没设** → 默认值；**设了** → 用设的值；**设成空串 / 只有空白 → 回落默认**
#   （这是她在群里唯一能看到的那句话，留空 = 只剩一个 @）。取值在
#   server/src/config/purchaseGroupNoticeText.js。
# ⚠️ 采购申请单与**退货单共用这同一条话术**（同一行代码 + 同一个渲染器，只有标题不同）
#   ⇒ 改它两张单子一起变、且逐字一致。
# ⚠️ `{supplier}` 供应商名 · `{pairs}` **双数**（= 这一组明细的 `quantity` 求和，不是条数）。
PURCHASE_GROUP_NOTICE_TEXT={supplier} 这批 {pairs} 双，图可以直接转给供应商。
# @经办人的飞书文本标记（`{openId}` = 那条记录经办人的 open_id）。
# ⚠️ 默认值末尾有**一个空格**（`@某某 三星 这批…`）；而环境变量层的值会被 `trim()`
#   ⇒ 从 env 配这一条时**末尾留不住空格**，要那个空格就用默认值（不配这个变量）。
PURCHASE_GROUP_NOTICE_MENTION_TEXT=<at user_id="{openId}"></at> 
# 供应商名取不到时的兜底写法（**绝不编**）：批次行没填供应商 / 货品没维护供应商时用它。
PURCHASE_GROUP_NOTICE_UNKNOWN_SUPPLIER_TEXT=未标注供应商

# ── 维度 1：每天 9 点推「最近 7 天还没收齐」的销售单（预定 / 现货待收）──
# 走 services/pendingDealPushService（候选口径**复用**第二次交付那套 listPendingDeliveries），
# 每笔一行：单号 + 待收金额 + 那条群消息的深链。配置取值都在 src/config/pendingDealPush.js。
# 🔴 2026-10-07 口径大改：交易类型 = 库存有没有（现货 / 预定），**「未付」不再是类型** ⇒
#   候选源 = 「预定（还没交付）」＋「现货但钱没结清」= **尚未完成履约**；
#   分区也从"交易类型编码"改成**履约状态**（见 config 里的 pendingDealPushCriterionFor）。
#
# 总开关，**显式布尔**：只有 true/1/yes/on 才起定时器；未配置、空串、false/0/no/off 都不起。
# 认不出来的值会在**启动时**抛错（不去猜，猜错的方式是静默的）。
PENDING_DEAL_PUSH_ENABLED=false
# 推到哪个群（chat_id，形如 oc_xxx）。**没有默认值**：留空 = 本次不推，只打一条
# sales.pending_deal_push.chat_missing 警告；**刻意不回落**到发给某个人的私聊。
PENDING_DEAL_PUSH_CHAT_ID=
# 几点推（北京时间 0–23，默认 9）。轮询间隔默认 10 分钟，"当天推过没有"由按天认领决定，
# 所以服务器晚起也不会漏掉当天这一趟。
PENDING_DEAL_PUSH_HOUR=9
# 轮询间隔毫秒（默认 600000 = 10 分钟）。
PENDING_DEAL_PUSH_INTERVAL_MS=600000
# 拿不到深链时要不要每次去问一次飞书（`im.message.get` 读 message_app_link）。**显式布尔**，默认 true。
# ⚠️ 实测（2026-10-06）该接口**不返回** message_app_link，所以默认开着也只是空跑一次；
#    留着它是因为那是官方声明过的字段，飞书哪天开始返回就自动生效，不用改代码。
PENDING_DEAL_PUSH_LINK_LOOKUP_ENABLED=true
# 拿不到深链时是否**干脆不推**。**显式布尔**，默认 false（照推货号尺码 + 金额，深链是增强不是前提）。
PENDING_DEAL_PUSH_LINK_REQUIRED=false
# 发出后**把那条消息置顶**（飞书 Pin，把这张待办清单钉在群顶部）。**显式布尔**，默认 **false**。
# 为什么默认关：置顶是**群里每个人都看得见**的副作用，且飞书那边有额外门槛——
#   应用要有 `im:message.pins:write_only`（或已有的 `im:message`）权限、机器人必须在那个群、
#   群若设成「仅群主/群管理员可 Pin」就直接失败（错误码 230046）。
# ⭐ 打开（=true）时的行为：**先把上一条我们自己置顶的取消，再置顶这一条**，
#   本地状态记在 data/pending_deal_push/pending_deal_push_pin_state.json ——
#   防的是"每天推一条、每次都钉 ⇒ 置顶越堆越多"（官方文档**没有**写一个群能置顶几条的上限）。
# 🔴 置顶失败（缺权限 / 群设置不允许 / 限流）**绝不影响推送本身**：只记 warn，
#   不抛错、不重试到死；上一条取消失败时**本次不置顶新的**（宁缺不堆）。
PENDING_DEAL_PUSH_PIN_ENABLED=false
# ── 发送形态与失败重试（2026-10-08 加）──────────────────────────────────────
# 发**消息卡片**（interactive）还是**纯文本**。取值只有 card / text（认不出来的值**启动时抛错**）。
# ⭐ 默认 card：业务负责人 2026-10-08 逐字「甲 **改成消息卡片**（interactive）」。
# ⭐ text 是**降级出口**（客户端不支持卡片时用）——内容与卡片同口径，只是没有卡片样式。
# ⚠️ 除了这个开关，代码里还有**自动降级**：卡片发送失败会立刻用同一份纯文本兜底发一次
#    （日志 sales.pending_deal_push.card.fallback 带上飞书真实 code/msg；兜底成功即算发出去了）。
# ⚠️ 飞书卡片 JSON 自带的 `fallback` 字段**只能**展示它自己的占位图（"请升级客户端至最新版本后查看"），
#    承载不了我们的文本 —— 所以真正的降级是上面这个纯文本出口，不是那个字段。
# PENDING_DEAL_PUSH_MESSAGE_FORMAT=card
# 推送失败后的重试时刻：**相对首次失败**的毫秒偏移，逗号分隔。默认 300000,900000 = 5 / 15 分钟。
# 业务负责人 2026-10-08 逐字：「失败后隔 **5/15 分钟**各重试一次，别一次失败就整天不发」。
# ⭐ 只重试**两次**（= 这里写几个窗口就重试几次）；两次都失败 ⇒ 当天不再试（第二天照常进候选）。
# ⚠️ **第一次失败不算"今天跑过了"**（这正是 2026-10-08 那次"09:05 失败 ⇒ 一整天不再发"的坑）。
# ⚠️ 重试是**幂等**的：当天记录里 `sent:true` 之后一次都不会再发。
# ⚠️ 留空 = 不重试（与全仓"空串 = 关掉"同一套规矩）。
# PENDING_DEAL_PUSH_RETRY_DELAYS_MS=300000,900000
# 文字链接的可见文案（URL 藏在它后面；默认「查看原话」）。
# PENDING_DEAL_PUSH_LINK_TEXT=查看原话
# 金额段模板（默认 `待收 {amount}`）。
# ⚠️ 待收为 0 → 换成下面那句；金额**读不出来** → 整段不渲染（**绝不**渲染 `¥—`，更不会变 `¥0.00`）。
# PENDING_DEAL_PUSH_AMOUNT_TEMPLATE=待收 {amount}
# 待收为 0 时写什么（默认「已付清」）。
# PENDING_DEAL_PUSH_PAID_UP_TEXT=已付清
# 卡片的配色：标题底色 / 金额高亮 / 两个区块的类型彩色标签（text_tag 的 color 枚举）。
# PENDING_DEAL_PUSH_CARD_HEADER_COLOR=blue
# PENDING_DEAL_PUSH_CARD_AMOUNT_COLOR=red
# PENDING_DEAL_PUSH_PREPAID_TAG_COLOR=blue
# PENDING_DEAL_PUSH_CASH_PENDING_TAG_COLOR=orange
# ── 分区与文案（2026-10-07 口径大改后：按【预定 / 现货待收】分区）────────
# 每个区块 = 标题 + 该区每单一行。
# ⭐ 2026-10-08：行 = **货号 尺码** + 【预定/现货待收】 + 待收金额 + 「查看原话」文字链接；
#    **不再有单号**（她明确说不需要），金额与链接段各自可整段消失。
# ⚠️ 下面这些**改文案用**，不配就用默认值；默认值与注释在 src/config/pendingDealPush.js
#    （那份文件是唯一的真源，这里只是把最常用的几个旋钮抄出来）。
# 区块顺序（逗号分隔；可用值 prepaid / cash_pending）。默认 `prepaid,cash_pending` = **预定在前**。
# 为什么预定在前：预定单货还没交出去（补尾款 + 出货 + 扣库存三步），链条最长、最怕拖过 7 天；
# 现货待收单货已交付、只剩收款一步。⚠️ 顺序里**漏写**的区块不会消失，会按声明顺序补在后面
# （宁可多显示一块，也不让一类单静默少推）。
# ⚠️ 旧值 `unpaid` 已随"未付不再是类型"退场：写它会在**启动时**报"没声明的区块"（故意的，
#    宁可吵一声，也不要静默按错误的区块顺序推）。
# PENDING_DEAL_PUSH_BLOCK_ORDER=prepaid,cash_pending
# 两个区块的标题（也是行内那个标签）。默认 【预定】 / 【现货待收】。
# PENDING_DEAL_PUSH_PREPAID_TITLE=【预定】
# PENDING_DEAL_PUSH_CASH_PENDING_TITLE=【现货待收】
# 判据不落在上面两块里的单落进这一块（兜底：绝不静默丢单）。默认 【其他】。
# PENDING_DEAL_PUSH_OTHER_TITLE=【其他】
# 表头模板。可用占位符：{day} {total} {blockCounts}（{total} 仍是"总共几笔"，口径不变）。
# ⚠️ 2026-10-08 文案 nit：**只有一个区块时不再补 {blockCounts}**（她真机看到的
#    「…：5 笔（【预定】5 笔）」把同一件事说了两遍）——判据在代码里，不需要新旋钮。
# PENDING_DEAL_PUSH_HEADER_TEMPLATE=⏰ {day} 最近 7 天待处理的销售单（预定 / 现货待收）：{total} 笔{blockCounts}
# 区块模板（`\n` 是**真的换行**，env 里请直接换行或整段不配）。可用：{title} {count} {lines}。
# PENDING_DEAL_PUSH_SECTION_TEMPLATE={title}{count} 笔
# {lines}
# 行模板：`|` 分隔的若干段，**空的段整段不要**（缺货号尺码/缺深链时不会留下空的分隔符）。
# 可用占位符：{index} {orderNo} {tag} {item} {amount} {link}。
# ⚠️ `{amount}` 给的是**整段**（`待收 ¥…` / `已付清`；读不出来整段没有）⇒ 段里**不要再写「待收」**。
# PENDING_DEAL_PUSH_LINE_PARTS={index}. {item}|{tag}|{amount}|{link}
# 段与段之间的分隔符（缺省 ` · `；⚠️ 环境变量的首尾空白会被去掉，要带空格请写进上面的段里）。
# PENDING_DEAL_PUSH_LINE_SEPARATOR= ·
# 一件商品：`{itemNo}` 是货号（配品是它的名称），`{size}` 是已经拼好后缀的尺码。
# ⚠️ 配品没有尺码时 `{size}` 是空串 → 只剩名称，**不会**出现「 码」这种残句。
# PENDING_DEAL_PUSH_ITEM_TEMPLATE={itemNo} {size}
# 一单多件之间的分隔符（默认顿号）。
# PENDING_DEAL_PUSH_ITEM_SEPARATOR=、
# 尺码后缀（默认 `{size}码`）。
# PENDING_DEAL_PUSH_SIZE_TEMPLATE={size}码
# 深链缺失时的脚注（可用 {count}）。默认文案逐字保留原有那句，便于按日志事件排查。
# PENDING_DEAL_PUSH_FOOTER_TEMPLATE=（{count} 笔的深链暂不可用：飞书接口未返回 message_app_link，见日志 sales.pending_deal_push.link.missing）
# ⚠️ 模板里的占位符**写错名字会在启动时抛错**（不认识 / 没闭合都在启动时就吵），
#    不会悄悄渲染成空串少给她一段信息。
# 🔴 曾经有一个「深链兜底模板」PENDING_DEAL_PUSH_LINK_TEMPLATE（运营自己填 URL 模板）。
#    业务负责人 2026-10-06 明确「不要补历史、也不要拼链接」之后**已整个删除**
#    （配置 / 代码 / 用例一起删的，见 config/pendingDealPush.js 与 services/larkMessageLinkResolver.js）。

# ── 大区：【销售】区 + 【团购券待结算】区 + 【采购】区（2026-10-08 加券那块）──────
# 一条消息里三个大区，顺序可配。默认 `sales,voucher,purchase`
#   = **销售两块在前、团购券待结算居中、采购在后**（业务负责人 2026-10-08 的口径）。
# ⚠️ 顺序里**漏写**的大区不会消失（按声明顺序补在后面）；写一个没声明的名字会在**启动时**报错。
# PENDING_DEAL_PUSH_AREA_ORDER=sales,voucher,purchase
# 销售区的大区标题。**默认空串 = 不渲染那一行**（销售区不加多余的一行）
#（要给她加大区标题时只改这一行，代码不用动）。可用占位符：{count}。
# PENDING_DEAL_PUSH_SALES_TITLE=
# 采购区的大区标题。可用占位符：{count}（这一区几批）。
# PENDING_DEAL_PUSH_PURCHASE_TITLE=【采购】未到货的报货批次：{count} 批
# 采购区行模板：`|` 分隔的若干段，空段整段不要。
# 可用占位符：{index} {batchNo} {supplier} {link}。
#   · {supplier} 从**「报货批次.供应商」**那一列取（2026-10-09 改；取不到就是空段，**不编**）；
#   · {link} 来自本地映射（data/purchase_group_messages 的 chat_id + thread_id）拼的话题深链。
# PENDING_DEAL_PUSH_PURCHASE_LINE_PARTS={index}. {batchNo}|{supplier}|{link}
# PENDING_DEAL_PUSH_PURCHASE_LINE_SEPARATOR= ·
# 一批多供应商时的连接符（默认顿号）。
# PENDING_DEAL_PUSH_PURCHASE_SUPPLIER_SEPARATOR=、
# 采购区深链缺失时的脚注（可用 {count}）。
# PENDING_DEAL_PUSH_PURCHASE_FOOTER_TEMPLATE=（{count} 批的深链暂不可用，见日志 sales.pending_deal_push.purchase_link.missing）

# ── 【团购券待结算】块 + 「确认到账」按钮（2026-10-08 业务负责人批准）──────────
# 口径（逐字）：「是收款明细里**待平台结算**的记录……按照 **5 个自然日**今日该到账的待结算金额，
#   右栏是用户的**确认按钮**，点击之后这笔待平台结算就会**变为已收款**」
#   「从收款明细里的**创建时间**开始算，创建时间是 1001，那么就是 1006」
#   「**逾期未点的要展示**，展示的维度是按**结算日**（今天该结算多少、昨天该结算多少）」
#   「标题叫【团购券待结算】，按钮文案为「确认到账」」；金额用券的「**平台结算款**」
# ⚠️ 全部默认值 / 取值规则见 src/config/voucherSettlement.js（下面这些只是**可覆盖**的旋钮）。
# 那一块显不显示（默认 true = 显示；清空 = 关掉这一块，销售 / 采购照发）。
# PENDING_DEAL_PUSH_VOUCHER_ENABLED=true
# 区块标题 / 左栏模板 / 逾期后缀 / 右栏按钮文案（可用占位符写错会在**启动时**报错）。
# PENDING_DEAL_PUSH_VOUCHER_TITLE=【团购券待结算】
# PENDING_DEAL_PUSH_VOUCHER_ROW_TEMPLATE={settleDay} 应结算 {amount}
# PENDING_DEAL_PUSH_VOUCHER_OVERDUE_TEMPLATE=（逾期 {days} 天）
# PENDING_DEAL_PUSH_VOUCHER_BUTTON_TEXT=确认到账
# 「结算日 = 核销日（收款明细.创建时间，上海自然日）+ N 个自然日」里的 N。
# VOUCHER_SETTLE_DAYS=5
# 表里的取值（业务事实，不是显示文案；改它之前先确认表里真的是这个值）。
# VOUCHER_SETTLE_PENDING_STATUS=待平台结算
# VOUCHER_SETTLE_SETTLED_STATUS=已收款
# VOUCHER_SETTLE_TRADE_DIRECTION=收入
# 卡片按钮的**动作名**（服务端按它分派；改它 = 新卡片与新分派一起改，配置先行）。
# VOUCHER_SETTLE_CONFIRM_ACTION=confirm_voucher_settlement
# 点击之后回的那几句话（可用占位符：{count} {amount} {settleDay} {failed} {error}）。
# VOUCHER_SETTLE_CONFIRMED_TEMPLATE=已确认 {count} 笔、共 {amount}（结算日 {settleDay}）
# VOUCHER_SETTLE_ALREADY_TEMPLATE=这一批已经确认过了（结算日 {settleDay}）

# ── 报货批次号（2026-10-07：不再手填，后端代码生成）────────────────────────
# 她的样例：CGD-20261007-0003 = 前缀 + 上海日期 + 4 位补零序号（每天归零）。
# ⚠️ 生成前缀与"群里识别哪些前缀"**刻意分成两个配置**：`BH-` 是历史格式，
#    生产表里有这样的号、她此前的群消息也可能还引用着 —— **历史号必须继续认得出**，
#    但新号不再用 `BH-`。默认值与注释在 src/config/purchaseBatchNo.js。
# PURCHASE_BATCH_NO_PREFIX=CGD-
# PURCHASE_BATCH_NO_DATE_FORMAT=YYYYMMDD
# PURCHASE_BATCH_NO_DIGITS=4
# PURCHASE_BATCH_NO_TIMEZONE=Asia/Shanghai
# 群里识别批次号时认哪些前缀（逗号分隔；**不能为空**，空列表 = 她在群里说批次号机器人永远"认不出"）。
# PURCHASE_BATCH_NO_PREFIXES=CGD-,BH-

# ── 报货批次的「到货状态」两个取值（2026-10-07）────────────────────────────
# 新建批次记录时写 pending；到货核对确认成功后写 arrived。
# 🔴 **不要随便改**：往飞书单选里写一个不存在的取值，飞书会**自动新建选项**（表被悄悄污染，
#    而 9 点推送按「未到货」查就静默查不到了）。改之前先在表里加好选项，
#    然后跑 `pnpm run v1:schema-check:purchase` 让闸门对着真表核对。
# PURCHASE_ARRIVAL_STATUS_PENDING=未到货
# PURCHASE_ARRIVAL_STATUS_ARRIVED=已到货

# ── 到货确认的「验收原话」/「确认状态」（**2026-10-09 全部删除**）─────────────
# 这两列 2026-10-07 晚曾从被删的「到货验收」表搬到「报货批次」那一行；2026-10-09
# 只读核对生产真表：**那两列也没有了**（报货批次真表 12 列里找不到）⇒ 按老规矩
# "映射 ＋ 写入点一起删"：
#   · `PURCHASE_ACCEPTANCE_CONFIRMED_STATUS` 与 `config/purchaseAcceptance.js`
#     **一并删除**，没有任何读取点（部署闸门的单选取值契约也去掉了这一条）；
#   · 「实际数量」「实际金额」**保留**（结构化验收照写）；「到货状态」保留。
#    **不要再加回来**：要么用**真链接**，要么那一栏**不显示**。
#
# ⭐ 但「真链接」现在有两条来源（都在 services/salesMessageLinkService 落地）：
#    ① 飞书发送响应里的 `data.message_app_link`（实测 2026-10-06 这个应用不回带）；
#    ② **她 2026-10-06 给的真实话题深链格式**：`applink.feishu.cn/client/thread/open`
#       ＋ 我们自己就有的 `chat_id` / `thread_id`（见下一条 SALES_THREAD_LINK_TEMPLATE）。
# ⚠️ ② 与上面被删掉的"兜底模板"**不是一回事**：那个是运营自己编一条没人验证过的 URL；
#    ② 是她给的、参数是我们发消息时真拿到的两个 id，点开就是那条话题。
#
# ── 话题深链格式（她 2026-10-06 给的真实样例）──
# 占位符：{chat_id} / {thread_id} / {thread_position}。**没配** = 用她给的那条（默认）；
# **设成空** = 显式不要拼这条链接（那就只剩飞书回带的 message_app_link 一条路）。
# 两个 id 缺任意一个时**代码直接返回空、留空**，不会用空值拼出一条点开是别处的链接。
# 她给的样例（点开后直接看到那条消息的所有沟通内容）：
#   https://applink.feishu.cn/client/thread/open?open_chat_id=<chat_id>&open_thread_id=<thread_id>
#     &openchatid=<chat_id>&openthreadid=<thread_id>&thread_position=-1
SALES_THREAD_LINK_TEMPLATE=

# ── 销售卡片三段：**类型 · 履约状态 · 收款情况**（业务负责人 2026-10-07 逐字）──
# 她的原话：「【卡片 = 分开说】类型 · 履约状态 · 收款情况（已收多少、还欠多少）」。
#   · 类型     —— **查完实时库存再定**（现货 / 预定），不是她嘴上说的性质；
#   · 履约状态 —— 由类型推出来（现货已交付 / 预定未交付；一张单两种都有 → 部分交付）；
#   · 收款情况 —— 已收多少 / 还欠多少（资金与类型**无关**）。
# ⚠️ 取值规则同上：**没设** → 默认值；**设了**（含空串）→ 就是显式取值。
# 三段各一行（可用占位符：{type} / {fulfillment} / {payment}）。
#  ⚠️ 占位符写错名字会在**解析时**抛错（不会悄悄渲染成空串）。
SALES_CARD_TRADE_TYPE_LINE=类型：{type}
SALES_CARD_FULFILLMENT_LINE=履约状态：{fulfillment}
SALES_CARD_PAYMENT_LINE=收款情况：{payment}
# 类型还没定（颜色还没选 / 库存还没查）时那两个字。**空串 = 用默认**（那是唯一可见的解释）。
SALES_CARD_UNDETERMINED_TEXT=待定

# ── 「第二次交付（成交）」提醒卡片上那几句（同一天口径大改后：不再说"未付 / 预付"）──
# 卡片标题（默认「待成交 / 待收款」）。
SECOND_DELIVERY_CARD_HEADER=待成交 / 待收款
# 主表「交易类型」关联读不出来时那一行的兜底说法（默认「待处理」）。
#  ⚠️ **不写「未付」这类类型词** —— 它要么有类型（现货/预定），要么就是"待处理"。
SECOND_DELIVERY_CARD_TYPE_FALLBACK=待处理

# ── 销售确认：点了「确认」之后那张卡片长什么样（业务负责人 2026-10-07 拍板的 ⓐ）──
# 起因（她的原话）：「我点击了确认后，卡片其实没变化，就会很让我迷惑，到底点击没点击」
# ⇒ 点确认后**那一次立即更新**的卡片要"一眼看出已经点上了、正在写入"。
# 全部键的语义：**没设** → 用默认值；**设了**（含空串）→ 就是显式取值（空串 = 那一项不要）。
# ⚠️ 只管「处理中」那张卡（stage=processing）；「已入账」终态卡与取消 / 待修正等卡片不受影响。
# 标题（默认「⏳ 销售订单处理中 · 正在写入…」）。要她给的原话示例就填：⏳ 正在写入…
SALES_PROCESSING_CARD_TITLE=⏳ 销售订单处理中 · 正在写入…
# 卡片头颜色：blue（默认）/ orange / red / grey / green。
SALES_PROCESSING_CARD_TEMPLATE=blue
# 明细区变灰用的颜色名（飞书 <font color='…'>）：默认 grey；空串 = 不套颜色。
SALES_PROCESSING_CARD_ITEM_COLOR=grey
# 明细上方那行醒目的"正在写入"提示（默认「⏳ 正在写入销售记录与收款…」）；空串 = 不出这一行。
SALES_PROCESSING_CARD_PROGRESS_LINE=⏳ 正在写入销售记录与收款…
# 卡片底部那句 note（默认「已收到确认，正在写入销售记录和收款；请勿重复点击。」）。
SALES_PROCESSING_CARD_NOTE=已收到确认，正在写入销售记录和收款；请勿重复点击。


# ── ⭐【确认成交】按钮：做在「已入账」终态卡上（业务负责人 2026-10-07 拍板的**甲**）──
# 口径（她的原话）：「一旦判定这一单是**预订或者现货未收**，入账之后就会给用户发一个消息卡片，
#  确认该笔交易是否成交。**只有当用户点击"是"的时候，才会触发我们后续的流程**。」
# ★ 实现方式（**甲**）：「把【确认成交】按钮**做在那张已经在你手里的卡上**（"已入账"那张终态卡）
#  —— **不新发消息**，你在原卡上点」
# ⚠️ 判据（哪张单有按钮）**不是这里配的**：预定（未交付）或现货有欠款才有，见
#    `src/config/salesConfirmDeal.js` 的 `needsConfirmDeal`。这里只配**文案**。
# ⚠️ 取值规则同上：**没设** → 默认值；**设了**（含空串）→ 就是显式取值（不回退默认）。
#    ⚠️ 按钮 / 提示 / 已成交 / 货没到 这四句是"留空她就看不懂这张卡"的那几句 ⇒ 空串时回退默认。
# 卡面上那**唯一**一个按钮的文字（默认「确认成交」）。⚠️ 不许放"取消 / 否 / 稍后"。
SALES_CONFIRM_DEAL_BUTTON_LABEL=确认成交
# 按钮上方那行小字（默认「点一次「确认成交」才会继续走后续流程。」）；空串 = 不出这一行。
SALES_CONFIRM_DEAL_HINT=点一次「确认成交」才会继续走后续流程。
# 点完之后那张卡的标题（默认「销售订单已成交」）。
SALES_CONFIRM_DEAL_SETTLED_TITLE=销售订单已成交
# 点完之后那行说明；`{clock}` = 上海时间的点击时刻（HH:MM）。
SALES_CONFIRM_DEAL_SETTLED_TEXT=✅ 已成交{clock}
# 上面 `{clock}` 的括号写法（默认「（{clock} 点击）」）。
SALES_CONFIRM_DEAL_SETTLED_CLOCK=（{clock} 点击）
# 点完之后卡片上那句 note；`{orderNo}` = 销售单号。
SALES_CONFIRM_DEAL_SETTLED_MESSAGE=销售单号：{orderNo}；已成交。
# ⭐ 上面那句的**续句**：交付只成了一半（还有几双没交出去）时追在它后面；`{count}` = 没交成的条数。
#   没有未交付时**一个字都不加**。留空 = 回退默认（这句是"还有几双没交"的唯一提醒，不该被藏起来）。
SALES_CONFIRM_DEAL_SETTLED_UNDELIVERED=仍未交付 {count} 双，请到工作台核对。
# 单号读不出来时的兜底说法（默认「请在销售主表核对」）。
SALES_CONFIRM_DEAL_ORDER_NO_FALLBACK=请在销售主表核对
# ⭐ 预定单**货还没到**（交付时库存不足）时回给她的那一句：明确说清、不写半成品账。
SALES_CONFIRM_DEAL_SHORT_STOCK=这双还没到货（或库存不够），先走到货入库，到货之后再到这张卡上点「确认成交」。
# 货做掉了、但"钱怎么收"问不出来时的提示（不猜方式，见她 2026-10-06 的口径）。
SALES_CONFIRM_DEAL_ASKING_TOAST=货已经记成交了；这笔钱是怎么收的？说一句我再记账
# 这一单已经成交（第二次点击 / 网络重试）时那句提示。
SALES_CONFIRM_DEAL_ALREADY_TOAST=这一单已经成交，无需重复处理
# 成交成功那句（`{summary}` = 补收款 / 交付的汇总）。
SALES_CONFIRM_DEAL_SUCCESS_TOAST=已成交：{summary}
# 成功汇总里"没什么可做的"时那四个字。
SALES_CONFIRM_DEAL_NOTHING_TEXT=无待处理项
# 失败那句（`{reason}` = 原因）。
SALES_CONFIRM_DEAL_FAILED_TOAST=这次确认成交没做完：{reason}


# ── 「补货品信息」那一段（业务负责人 2026-10-07：从确认卡片挪到【点确认之后的卡片】）──
# 起因（她的原话）：「我们的卡片能够实时更新，更新完之后，用户要补的链接其实就看不到了。
#  所以我们在销售信息确认卡片里不需要放这个信息；等用户点击确认之后，卡片不是会更新吗？
#  更新时再补这个信息。」
# 🔴 当天她把"哪几张卡带"改了**两次**（原话都留着，最新口径 = ① 和 ② 都要有）：
#  ① 第一版（PR #220）：处理中卡 + 已入账终态卡**都放**；
#  ② 她随后纠正（逐字）：「**不是，是只放在2上！**」（①=「销售订单处理中」卡、
#     ②=绿色「销售订单已入账」终态卡）⇒ PR #221 收窄成**只放 ②**；
#  ③ 她当天再改口（逐字，**最新**）：「**中间态也应该有提示**」⇒ **处理中卡也加回来**。
# ⇒ 现在这一段在：①「销售订单处理中」卡（`salesProcessingCard`）＋
#  ②「销售订单已入账」终态卡（以及"已入账，部分交付 / 交付待处理"那两张 ——
#  它们同样是**已入账**的单据、卡片同样长期留着）。
# ⚠️ 确认卡片（点之前）**始终不带**：那张卡会被 patch 覆盖，链接她永远看不到。
# ⚠️ 取消 / 待修正那两张**不带**（原草稿不会入账，没有单据需要补资料）。
# ⚠️ 取值规则同上：**没设** → 默认值；**设了**（含空串）→ 就是显式取值，不回退默认。
# 段落标题（默认「补货品信息」）。
PRODUCT_INFO_GAPS_TITLE=补货品信息
# 每行「<货号+颜色>」与缺项之间的连接词（默认「还差：」）。空串 = 不显示它。
PRODUCT_INFO_GAPS_MISSING_LABEL=还差：
# 「样例图」这一项在卡片上的显示名（默认「样例图」；附件字段不在飞书公式里，由代码单独判）。
PRODUCT_INFO_GAPS_SAMPLE_IMAGE_LABEL=样例图
# 缺项后面那个链接的可见文字（默认「去补全这条记录」）。
PRODUCT_INFO_GAPS_LINK_LABEL=去补全这条记录
# 缺口超过上限时那最后一行；`{count}` 会被替换成"还有几个"。
PRODUCT_INFO_GAPS_OVERFLOW_TEXT=还有 {count} 个颜色也缺资料，可在「货品信息」里筛选「信息是否齐备」查看。
# 最多列几条（默认 6；飞书卡片有高度上限，太长会被截断）。0 = 这一段整个不显示。
PRODUCT_INFO_GAPS_MAX_LINES=6


# ── 销售录单：A（读「货品信息」）之后那道「这个货号到底有没有建档」的判据（2026-10-07）──
# 起因（业务负责人口径，逐字）：「对，所以三种交易类型，在看完货品信息之后，如果在货架上
#  没有找到，都应该给到这个提示，而不是说等到 B」。
# 真机那一单：`B26002-52` 被语音转文字漏成 `26002-52`，走**预付** —— A 空手回来不吭声、
#  B（实时库存）按交易类型又不跑 ⇒ **点了确认才失败**。现在在 A 之后当场拦。
# ⚠️ 它只管「**这张表里有没有这个货号的记录**」；「货号有、只是齐备公式说缺字段
#  （缺成本…）」**仍然不拦**，只进「补货品信息」那一段（**处理中卡 + 已入账终态卡**都带；
#  见上面那段配置）——**没建档要拦、缺资料不拦**，两者判据是分开的。
# ⚠️ 判据要的是**正证据**（AGENTS.md 第 17 条）：只有「「货品信息」整表读成功 +
#  里面确实没有这个货号」才拦；读不到就不下结论、不拦单，并记一条
#  `lark.sales.product_missing.undetermined` 警告留痕。
# ⚠️ 取值规则同上：**没设** → 默认值；**设了**（含空串）→ 就是显式取值，不回退默认。
#   开关是**显式布尔**：空串 = 关掉（关掉时不拦，但记一条 `…guard_disabled` 留痕）。
# 默认开（true）。关掉 = 回到判据之前的行为（只有 B 兜得住的那三种交易类型会被拦）。
SALES_PRODUCT_REGISTRATION_GUARD_ENABLED=true
# 拦截时回她的那句话；`{item_no}` 会替换成**这一条明细**的货号
#（一单多双、只缺其中一双时只报那一双）。
# ⚠️ 文案**设成空串 = 用默认文案**（与「补货品信息」那段"空串 = 渲染成空"有意不同）：
#   这句话是拦截时唯一可见的解释，留空会变成"没卡片、也没回复"。
#   **要关掉拦截请用上面的开关**，不是把文案清空。
SALES_PRODUCT_REGISTRATION_MISSING_TEXT=货品信息里没有 {item_no}，请先在「货品信息」建档或核对货号，再发一次～


# ── 销售录单：颜色由 A 给**全色**候选、B 拿"选定颜色"查实时库存 → **这才是类型的判据** ──
# 业务负责人的三步流程（逐字）：「1. 货品信息还是要先查这个货品有没有、信息全不全
#  2. 这里要给到**全色**，让用户去选
#  3. 用户选完之后，再拿着用户选的颜色去……找，如果找到了，就是现货，如果没找到，就是预定」
# 两张表都跑（**没有"按类型跳过"的开关**）：A 给全部颜色 → 她选 → B 查库存定类型
#  （有货 = 现货，没货 = 预定；见 `config/salesTradeTypePolicy.salesTradeTypeForStock`）。
# ⚠️ 候选按钮**只显示颜色名**（`黑色` / `绿色`）——**没有**"有货 / 无货"预览标注；
#  「候选从哪来」在 `services/larkMvpService`。
# ⚠️ `SALES_COLOR_STOCK_LABEL_AVAILABLE` / `SALES_COLOR_STOCK_LABEL_UNAVAILABLE` 两个后缀
#  变量**已于 2026-10-07 随预览标注一并删除**（业务负责人逐字：「**甲 去掉**……
#  候选只显示颜色（黑色 / 绿色），**选完 → 再查库存 → 告诉她"这双有货→现货"或"没货→预定"**」）
#  ——**不要再加回来**（加了也不会有人读，`.env` 里留着它更是死配置）。
# ⚠️ 取值规则同上：**没设** → 默认值；**设了**（含空串）→ 就是显式取值。
# ⚠️ 她点完颜色、但这一次**读不到**「实时库存」时回她的那句（默认「暂时读不到库存，请再点一次颜色～」）。
#  读不到就**不下**"现货 / 预定"的结论（AGENTS.md 第 17 条），候选保留、她再点一次即可。
#  设成**空串 = 用默认文案**（它是失败时唯一可见的解释，留空 = 她只看到"点了没反应"）。
SALES_COLOR_STOCK_LOOKUP_FAILED_TEXT=暂时读不到库存，请再点一次颜色～

# ⭐ 2026-10-07 撤销"候选只推在售"：**候选 = 全部颜色**（`SALES_COLOR_SCOPE_EMPTY_TEXT`
#  那条"颜色全下架"的拦截、以及 `colorOptionsScope` 那套范围配置**已整体删除**）。
#  理由：预定 = 没货，若候选只推在售，她永远选不到没货的颜色 ⇒ 预定这条路走不通。
#  全下架 / 全没货 = 全部记预定，是**合法输入**，不再拦截。


# ── 销售「销售信息还缺…」追问的**文案**（业务负责人 2026-10-07 18:38 真机）──
# 她的原话（逐字）：「**这个提醒是什么意思？**」—— 她收到的那一条是：
#   「销售信息还缺：定金单暂只支持一条明细；多双请分开说明，或逐双给出成交金额、
#     items[0].actual_amount、items[1].actual_amount、payments[0].method、请逐件说明成交金额、
#     已收金额和待平台结算金额不能超过本单成交金额。请补充后重新发送完整销售信息。」
# 三个毛病：① 漏了代码标识符（`items[0].actual_amount` 这类）；② 4~5 句堆成一段；
#          ③ 结尾「请补充后重新发送完整销售信息」没有具体动作。
# ⇒ 改后：**一件事一行 + 每条都有具体动作 + 一个字都不含代码标识符**。
#
# ⚠️ 判据**一个字没动**：什么情况下报缺项 / 不出卡片 / 不入账在
#   `services/doubaoService.normalizeSalesResult` 与 `services/larkMvpService.processSalesTask`，
#   它们产出的 `missing_fields`（机器清单，含 `items[0].actual_amount`）**原样保留**
#   （照旧写进「解析结果摘要」JSON 与本地任务）。这里配的只是**给她看的那一层**。
# ⚠️ 取值规则同上一段：**没设** → 默认值；**设了** → 用设的值；
#   **设成空串 / 只有空白 → 回落默认**（这是她那一刻唯一能看到的解释，留空 = 她只看到"缺了几处"）。
# ⚠️ 多行文案（下面那条定金例子）在 `.env` 里用 `\n` 两个字符表示换行。
# ⚠️ `{…}` 是占位符：`{count}` 行数 · `{index}` 第几行 · `{item}`/`{items}` 一件/多件货的说法
#   · `{itemNo}` `{size}` `{accessoryName}` · `{firstItem}` `{secondItem}` 定金例子的两件货
#   · `{quantity}` 这一条里写的双数。清单与默认值都在 `server/src/config/salesMissingInfoText.js`。
# 开头那句汇总（{count} = 下面**行数**，同类缺项会被合并成一行）。
SALES_MISSING_INFO_INTRO_TEXT=销售信息还缺 {count} 处，请照着补一下～
# 「这双没说成交金额」：`items[i].actual_amount` 与泛化的「请逐件说明成交金额」**合并成这一条**，
# `{items}` 会把缺金额的那几双连货号带尺码列出来（如 `31678 40码、6681-1 42码`）。
SALES_MISSING_INFO_ITEM_AMOUNT_TEXT=请给每双鞋都说一个成交金额：{items}
# 只有泛化那句、没具体到某一件时的兜底（正常场景走不到）。
SALES_MISSING_INFO_ITEM_AMOUNT_GENERIC_TEXT=请给每双鞋都说一个成交金额～
# ⭐ 成交额**压根没解析出来**（她只说了定金、没说尾款）时问的那一句：
# 它与上面 `ITEM_AMOUNT_TEXT` 问的是**同一件事** ⇒ 渲染层把两条**合成一行**（用这一句 + `{items}`）。
# ⚠️ 这时**绝不许**再说「已收的钱比这单成交金额还多」——成交额是空的，那是误导。
SALES_MISSING_INFO_ITEM_AMOUNT_UNKNOWN_TOTAL_TEXT=请说明这单成交金额（或定金+尾款分别是多少）：{items}
# 上面那句取不到任何一件货的说法时的退路（不留空）。
SALES_MISSING_INFO_UNKNOWN_TOTAL_TEXT=请说明这单成交金额（或定金+尾款分别是多少）
# 单件还缺某个字段（`items[i].<字段>`）时那一句；`{item}` = 这一件的说法。
SALES_MISSING_INFO_ITEM_NO_TEXT={item} 没说货号，请补一下货号～
SALES_MISSING_INFO_ITEM_SIZE_TEXT={item} 没说尺码，请补一下是多少码～
SALES_MISSING_INFO_ITEM_QUANTITY_TEXT={item} 没说几双，请补一下数量～
SALES_MISSING_INFO_ACCESSORY_NAME_TEXT=有一件配品没说是什么，请补一下它的名字～
SALES_MISSING_INFO_ITEM_FIELD_FALLBACK_TEXT={item} 这条还缺一项信息，请核对后补一下～
# 收的那笔钱缺方式 / 缺金额。⚠️ 收款方式**她会主动说**（AGENTS.md 第 16 条）——
# 这里只是问一句，**不许**写成"默认微信"这类猜法。
SALES_MISSING_INFO_PAYMENT_METHOD_TEXT=收的那笔钱没说收款方式，请补一句是微信、现金还是支付宝～
SALES_MISSING_INFO_PAYMENT_AMOUNT_TEXT=没说这单收了多少钱，请补一句收了多少钱～
# ⭐ 她撞到的那一句。原话是「定金单暂只支持一条明细；多双请分开说明，或逐双给出成交金额」：
# ①「明细」是内部说法 → 改说"一双"；② 没说怎么办 → 给**具体动作**（分开发送）＋**当场给例子**。
# 例子只在"正好两件"时用（"第一条 / 第二条"才成立），否则用下面那条不带例子的。
#
# ⚠️⚠️ **上游已变（PR #234 合入，2026-10-07）：「定金单暂只支持一条明细…」这句生产者已删除**
#    （#234 放开了「多明细 + 定金」，原 `doubaoService.js:281-284` 的整单护栏整段删掉）。
#    ⇒ **当前链路永远不会再产生这句**，下面这两条键是**历史形状兜底**：
#      只防"改动前落盘的老 `needs_info` 任务被重放"时渲染器读到历史原文而退化成原样透传。
#      ⚠️ 保留是**有意**的（成本为零，收益是老任务重放也不漏「明细」/「；」），不是漏删。
SALES_MISSING_INFO_DEPOSIT_MULTI_LINE_EXAMPLE_TEXT=带定金的单一次只能记一双，请把这两双分开发送～\n（例如第一条只说「{firstItem}」，第二条只说「{secondItem}」的定金）
SALES_MISSING_INFO_DEPOSIT_MULTI_LINE_TEXT=带定金的单一次只能记一双，请把这几双分开发送～
# ⭐ #234 **新增**的那一句（`config/salesTradeTypePolicy.SALES_MULTI_LINE_DEPOSIT_TARGET_AMBIGUOUS`）。
# 生产者原话：「这一单里哪一件是付了定金的那件，我有点拿不准，请逐件说明哪一件付了定金、每双多少钱～」
# 原话本身已不含标识符 /「；」/「明细」，但"原样透传"等于没映射（不可配、也点不出是哪两双）。
# 所以映射成下面这条：把 `{items}`（这一单的每一双）当场点出来，再问"哪一件付了定金、每双多少钱"。
# ⚠️ 措辞**只说钱的事**：类型（现货 / 预定）是查完实时库存才有的结论，不该反过来问她。
# 一点货都取不出来（items 为空）时用 `..._GENERIC_TEXT` 那条（不带清单的退路）。
SALES_MISSING_INFO_DEPOSIT_TARGET_AMBIGUOUS_TEXT=这一单里哪一件是付了定金的那件，我有点拿不准～请对着「{items}」逐件说清楚哪一件付了定金、每双多少钱～
SALES_MISSING_INFO_DEPOSIT_TARGET_AMBIGUOUS_GENERIC_TEXT=这一单里哪一件是付了定金的那件，我有点拿不准～请逐件说清楚哪一件付了定金、每双多少钱～
SALES_MISSING_INFO_DEPOSIT_AMOUNT_TEXT=请说一句这次收了多少定金～
SALES_MISSING_INFO_DEPOSIT_METHOD_TEXT=请说一句这次定金是怎么收的（微信还是现金）～
SALES_MISSING_INFO_DEPOSIT_TAIL_TEXT=尾款还没付就请补一句「尾款以后付」，已经付了就补一句实收金额～
SALES_MISSING_INFO_DEPOSIT_PRICE_MISMATCH_TEXT=成交价和「定金 + 尾款」对不上，请核对一下～
# 一条里写了多双（原话带「；」）。
SALES_MISSING_INFO_ITEM_QUANTITY_MULTI_LINE_TEXT=一双鞋只能记一条，请把这 {quantity} 双分开发送～（每双各发一条，写清货号、尺码和成交金额）
# 总额 vs 各件之和的**泛化**版；解析层那句带具体数字的（#231）**原样透传、不改写**。
SALES_MISSING_INFO_ITEMS_TOTAL_MISMATCH_TEXT=每双鞋的成交金额加起来，和整单成交金额对不上，请核对一下～
SALES_MISSING_INFO_RECEIVED_EXCEEDS_TOTAL_TEXT=已收的钱比这单成交金额还多，请核对一下收了多少～
# 团购券：一次一双（原话带「；」）。
SALES_MISSING_INFO_VOUCHER_ONE_ORDER_ONE_PAIR_TEXT=团购券一次只能用在一双鞋上，请分开发送并逐双说明券后成交金额～
# 非销售意图（查记录 / 退货之类）时的兜底一句。
SALES_MISSING_INFO_UNSUPPORTED_INTENT_TEXT=这一条只支持商品销售录单，其他类型请先按对应方式发给我～
# 「一件货」的说法（给上面那些 `{item}` 用）：货号 + 尺码 / 只有货号 / 只有尺码 / 都取不到。
SALES_MISSING_INFO_ITEM_LABEL_WITH_SIZE_TEXT={itemNo} {size}码
SALES_MISSING_INFO_ITEM_LABEL_SIZE_ONLY_TEXT={size}码
SALES_MISSING_INFO_ITEM_LABEL_FALLBACK_TEXT=第 {index} 双
# 行首编号。⚠️ 环境变量层的值会被 `trim()`（`config/envValue` 的既有规矩）：
# 从 env 配的行首**末尾不会留空格**，要空格就用默认值、或把分隔符写进模板本体（如 `{index}、`）。
SALES_MISSING_INFO_LINE_PREFIX_TEXT={index}. 


# ── 飞书事件心跳自检（「机器人还收不收得到消息」）──
# 事件入口每次收到请求都会把时间写进 server/data/lark_event_heartbeat.json（内存 + 落盘，
# 重启不丢）。GET /api/lark/events/health 会返回心跳；scripts/check-lark-events.mjs 读它做自检。
# 心跳文件覆盖路径。留空 = server/data/lark_event_heartbeat.json（server/data 已 gitignore）。
LARK_EVENT_HEARTBEAT_FILE=
# 超过多少分钟没收到**任何**飞书事件就算异常（默认 180）。
LARK_EVENT_STALE_MINUTES=180
# ⚠️ 告警总开关，**显式布尔**：只有 true/1/yes/on 才发，其余（含未配置、空串）一律不发。
# 默认关，是为了在开发机上手动跑自检时不会往生产群发假告警。
LARK_EVENT_ALERT_ENABLED=false
# 告警发到哪：purchase_group（默认，用上面的 PURCHASE_CHAT_ID）| owner（用下面的 open_id）。
LARK_EVENT_ALERT_TARGET=purchase_group
# target=owner 时的接收人 open_id（形如 ou_xxx）。留空 = owner 目标发不出去（脚本报错退出）。
LARK_EVENT_ALERT_OPEN_ID=
# 群里告警是否 @所有人（显式布尔，默认关）。
LARK_EVENT_ALERT_MENTION_ALL=false
# 告警文案里要写的**正确**回调地址（填错就是"机器人收不到消息"的根因）。
LARK_EVENT_CALLBACK_URL=https://api.bamamei.online/api/lark/events

# Required after creating the separate "报货批次" table.
FEISHU_V1_PURCHASE_ORDER_BATCH_TABLE_ID=tblwezby9wRea9qi
# ⚠️ 2026-10-07 深夜：「采购入库」表被业务负责人**整表删除** ⇒
#     `FEISHU_V1_PURCHASE_INBOUND_TABLE_ID`（原先指 `tblK3Uzd0nN1GJrr`）**没有任何读取点**了，
#     随表一起从这里删除。**不要加回来**：到货链路只保留"更新报货批次 + 加库存"，
#     没有入库明细行这回事了（见 docs/purchase-inbound-table-removal-2026-10-07.md）。
FEISHU_V1_INVENTORY_LEDGER_TABLE_ID=tbl7Xo4OPmaN2NdP
FEISHU_V1_LIVE_INVENTORY_TABLE_ID=tblTr5qgiZXPADLP
# Real inventory E2E test only. Must point to an isolated test Base, never production.
FEISHU_V1_E2E_TEST_APP_TOKEN=
FEISHU_V1_E2E_PRODUCT_RECORD_ID=
FEISHU_V1_E2E_ITEM_NO=
FEISHU_V1_E2E_SIZE=
FEISHU_V1_MONEY_LEDGER_TABLE_ID=tblnaGV5zKruqUJI
FEISHU_V1_SUPPLIER_PAYABLE_TABLE_ID=tblTtR1rSUjj5npj

# ── ⭐ 扫码页（`GET /s/:number`）的取数提速（2026-10-08 业务负责人：「扫码页打开有点慢」）──
# 提速前：每次扫码**整表读三张表**（货品信息 + 实时库存 + 尺码管理），
# 其中整表读「实时库存」真机实测 5~9 秒。现在改成"按条件只读这一次需要的那几行" + 一层短 TTL 缓存。
# ⚠️ 全部取值都在 `src/config/scanPage.js` 的 `reads` / `cache` 里，这里只是旋钮。
#
# 过滤读总开关（显式布尔，默认开）。设成 false / 空 = **回到提速前的整表读**
# （线上万一出问题时的"一键退回"；代码里还有一层：飞书不认这个 filter 时自动回退整表读）。
SCAN_PAGE_FILTER_READ_ENABLED=true
# 视图缓存开关（显式布尔，默认开）。缓存的是"编号 → 视图模型"，
# ⚠️ 这条链路只读，但**库存会变** ⇒ TTL 必须短；"脏窗口"就等于下面这个 TTL。
SCAN_PAGE_CACHE_ENABLED=true
# 缓存 TTL（毫秒，1000~600000，默认 45000 = 45 秒）。
# 同一个 TTL 也用在「尺码管理」那 15 条的整表缓存上（那张表几乎不变）。
SCAN_PAGE_CACHE_TTL_MS=45000
# 最多缓存多少个编号（1~10000，默认 200；满了先清过期的，再淘汰最久没用的）。
SCAN_PAGE_CACHE_MAX_ENTRIES=200

# ── ⭐ 「实时库存」内存快照（2026-10-09 业务负责人：「首屏毫秒级……库存要准确」）──
# 后台每一拍把「实时库存」**整张表**拉进内存，扫码时直接查内存（不再依赖 filter、也不会回退整表）。
# 快照**只读**、不改任何业务语义；未就绪 / 过期 / 刷新失败一律回退老的"按编号过滤读"并记日志。
# ⚠️ 全部取值都在 `src/config/scanPage.js` 的 `snapshot` 里，这里只是旋钮。
#
# 总开关（显式布尔，默认开）。设成 false / 空 = 回到"每次扫码都去飞书读"（一键退回）。
SCAN_PAGE_SNAPSHOT_ENABLED=true
# 后台刷新间隔（毫秒，1000~600000，默认 30000 = 30 秒）。她说 30 秒就够。
SCAN_PAGE_SNAPSHOT_REFRESH_MS=30000
# 超过这个年龄就不再吃快照（毫秒，默认 90000 = 3 拍）：连着刷新失败也不会一直吃旧数据。
SCAN_PAGE_SNAPSHOT_MAX_AGE_MS=90000
# 整表上限（默认 20000，与回退整表读的上限同量级）：超了**不作快照**（回退 + 记 warn），绝不截断。
SCAN_PAGE_SNAPSHOT_MAX_RECORDS=20000
# 写操作失效后是否立刻重拉一次（显式布尔，默认开）。关掉就只有 30 秒那一拍。
# ⚠️ 写操作**立刻失效**这一条与它无关：失效永远是同步生效的（她要求"库存准确"）。
SCAN_PAGE_SNAPSHOT_REFRESH_ON_INVALIDATE=true

# ── ⭐ 「货品信息」内存索引（2026-10-09 业务负责人：**单价以「货品信息」为唯一真源**）──
# 与上面的「实时库存」快照**同一套机制**（同一个工厂，只是 tableKey=product）：
# 后台定期整表拉一次（按**编号**找货品）⇒ 扫码时**单价零飞书调用**；
# 未就绪 / 过期 / 刷新失败一律回退"按编号过滤读"；写货品（新建 / 改价 / 写标签二维码）
# 立刻失效（**只作废这一张表**，不拖累库存快照）。
# ⚠️ 她**否掉**的方案："在「实时库存」加单价列"（会造成同一款多份单价、改价要批量改）。
# 取值在 `src/config/scanPage.js` 的 `productSnapshot` 里。
SCAN_PAGE_PRODUCT_SNAPSHOT_ENABLED=true
# 后台刷新间隔（毫秒，默认 60000 = 60 秒）：货品与价格都变得慢，比库存那一拍可以长一些。
SCAN_PAGE_PRODUCT_SNAPSHOT_REFRESH_MS=60000
# 超过这个年龄就不再吃它（毫秒，默认 300000 = 5 分钟）。
SCAN_PAGE_PRODUCT_SNAPSHOT_MAX_AGE_MS=300000
# 整表上限（默认 50000；线上「货品信息」约 2 万行）：超了**不作快照**（回退 + 记 warn）。
SCAN_PAGE_PRODUCT_SNAPSHOT_MAX_RECORDS=50000
# 写操作失效后是否立刻重拉一次（显式布尔，默认开）。
SCAN_PAGE_PRODUCT_SNAPSHOT_REFRESH_ON_INVALIDATE=true

# ── ⭐ 尺码段（2026-10-09 业务负责人：A 男 38–48 · B 女 34–43）───────────────
# 缺码判定**读配置段**（不再每次扫码读「尺码管理」）；类别为空 / 配置里没有这个类别 ⇒ 降级
# （只显示有货尺码、不做缺码提示 + 一条可 grep 的 warn）。
# ⚠️ 段的**值**在 `src/config/scanPage.js` 的 `sizeSegments.ranges`（要改段就改那里）。
# ⭐ 一致性保险：定期拿配置与「尺码管理」比对，不一致 logWarn（例如表里加了 49 码）。
SCAN_PAGE_SIZE_CONSISTENCY_CHECK_ENABLED=true
# 两次比对之间的最小间隔（毫秒，默认 600000 = 10 分钟；0 = 每次都查，只建议排查时用）。
SCAN_PAGE_SIZE_CONSISTENCY_TTL_MS=600000

# ── ⭐ 扫码页「本单条」的【继续扫下一个】（2026-10-11 业务负责人：
#     「我们在扫码页卖了多双鞋的时候，怎么可以一双订单多次扫码呢？」）──────────
# 取值的唯一真源在 `src/config/scanPage.js` 的 `scanNext`（这里只是旋钮）。
# 手段 = **飞书官方 AppLink 打开「扫一扫」**（`common-capabilities/applink-protocol/…/open-scan-function`，
# 飞书 5.7.0+、**PC 端不支持**）；页面里**依然一行前端脚本都没有**，它只是一个真链接。
# ⚠️ 设备能力由**服务端看 UA**判（`views/scanPageRenderer.js` 的 `canScanNextWithFeishu`）：
#    飞书手机客户端才给按钮；电脑 / 手机自带浏览器只给一句人话（绝不给点了没反应的按钮）。
SCAN_NEXT_APPLINK=https://applink.feishu.cn/client/qrcode/main
