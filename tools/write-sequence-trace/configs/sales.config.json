      "table_id_env": "FEISHU_V1_PAYMENT_RECORD_TABLE_ID",
      "table_id": "tblTpLOtTLhWxXvm"
    },
    {
      "key": "liveInventory",
      "label": "实时库存",
      "table": "实时库存",
      "role": "snapshot",
      "table_id_env": "FEISHU_V1_LIVE_INVENTORY_TABLE_ID",
      "table_id": "tblTr5qgiZXPADLP"
    }
  ],
  "phases": [
    {
      "name": "① 销售建单",
      "from": 0,
      "to": 28
    },
    {
      "name": "② 库存出库",
      "from": 58,
      "to": 88
    },
    {
      "name": "重试",
      "from": 93,
      "to": 107
    },
    {
      "name": "③ 资金收款",
      "from": 109,
      "to": 115
