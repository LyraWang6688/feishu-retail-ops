{
  "name": "feishu-retail-ops-server",
  "version": "0.4.0",
  "description": "Feishu V1 backend for feishu-retail-ops: sales, purchase, inventory and workbench",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js --only box2bitable-server",
    "v1:schema-check": "node scripts/validate_v1_schema.js sales",
    "v1:schema-check:sales": "node scripts/validate_v1_schema.js sales",
    "v1:schema-check:purchase": "node scripts/validate_v1_schema.js purchase",
    "v1:schema-check:inventory": "node scripts/validate_v1_schema.js inventory",
    "v1:schema-check:all": "node scripts/validate_v1_schema.js all",
    "test": "node --require ./test/support/table-id-env.js --test --test-concurrency=1 test/*.test.js",
    "e2e:real": "node --test --test-concurrency=1 e2e/real-paths.mjs && FEISHU_TARGET_ENV=test node scripts/e2e-product-tag-qr.js",
    "env:selfcheck": "node scripts/env-selfcheck.mjs",
    "scan:repair-interrupted": "node scripts/scan-repair-interrupted.js",
    "test:realbase": "node --test --test-concurrency=1 --test-force-exit test/realbase/*.test.js"
  },
  "keywords": [
    "shoe-box",
    "recognition",
    "ai",
    "bitable",
    "feishu"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^4.18.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
