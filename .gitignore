# Dependency
node_modules/
.pnpm-store/

# Env
# .env 里是凭证，且不在版本库内 —— 改它之前先备份。
# 备份必须用这个命名（.env.backup.<时间戳>），否则会露在 git status 里、
# 有被误提交进仓库的风险：服务器上一直用的是这个前缀。
.env
.env.backup.*
.env.bak.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Assets
小程序码.jpg

# Mini Program
project.private.config.json
package-lock.json
dist/
unpackage/

# Server runtime uploads
server/uploads/
server/data/

# Local debug scripts
server/test_feishu.js

# Personal working notes (kept on local disk only, never pushed)
PROJECT.md

# Repository-level local-only state. QR codes, local staging copies and
# machine-local auth material stay on disk and are never committed.
# Previously this was excluded only through .git/info/exclude, which is
# per-clone and invisible to future agents; declaring it here makes the
# boundary part of the repository contract.
.local/
